import pandas as pd

xls = pd.ExcelFile('online_retail_II.xlsx')
df = pd.concat([pd.read_excel(xls, sheet_name=s) for s in xls.sheet_names], ignore_index=True)

# Missing values
print(df.isnull().sum())

# Duplicates — check on business columns only, NOT per-sheet
dupe_cols = ['Invoice','StockCode','Description','Quantity','InvoiceDate','Price','Customer ID','Country']
print("Duplicate rows:", df.duplicated(subset=dupe_cols, keep='first').sum())

# Clean
df_clean = df.drop_duplicates(subset=dupe_cols, keep='first')
df_clean = df_clean.dropna(subset=['Customer ID'])
print("Final row count:", len(df_clean))
